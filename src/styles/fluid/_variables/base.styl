// font
$font-size = theme-config("font.size", "16px")
$letter-spacing = theme-config("font.letterSpacing", "0.02em")
$font-family = theme-config("font.family", "var(--font-family-sans-serif)")
$code-font-size = theme-config("font.codeSize", "85%")

// body
$body-bg-color = theme-config("color.bodyBg", "#eee")
$body-bg-color-dark = theme-config("color.bodyBgDark", "#181c27")

// text
$text-color = theme-config("color.text", "#3c4858")
$text-color-dark = theme-config("color.textDark", "#c4c6c9")
$sec-text-color = theme-config("color.secText", "#718096")
$sec-text-color-dark = theme-config("color.secTextDark", "#a7a9ad")

// post
$post-text-color = theme-config("color.postText", "#2c3e50")
$post-text-color-dark = theme-config("color.postTextDark", "#c4c6c9")
$post-heading-color = theme-config("color.postHeading", "#1a202c")
$post-heading-color-dark = theme-config("color.postHeadingDark", "#c4c6c9")
$post-link-color = theme-config("color.postLink", "#2c3e50")
$post-link-color-dark = theme-config("color.postLinkDark", "#c4c6c9")
$link-hover-color = theme-config("color.linkHover", "#30a9de")
$link-hover-color-dark = theme-config("color.linkHoverDark", "#30a9de")
$link-hover-bg-color = theme-config("color.linkHoverBg", "#ebedef")
$link-hover-bg-color-dark = theme-config("color.linkHoverBgDark", "#364151")
$line-color = theme-config("color.line", "#eaecef")
$line-color-dark = theme-config("color.lineDark", "#435266")
$button-bg-color = theme-config("color.buttonBg", "#f6f8fa")
$button-bg-color-dark = theme-config("color.buttonBgDark", "#2f4154")
$button-hover-bg-color = theme-config("color.buttonHoverBg", "#f2f3f5")
$button-hover-bg-color-dark = theme-config("color.buttonHoverBgDark", "#46647e")

// navbar
$navbar-bg-color = theme-config("color.navbarBg", "#2f4154")
$navbar-bg-color-dark = theme-config("color.navbarBgDark", "#1f3144")
$navbar-text-color = theme-config("color.navbarText", "#fff")
$navbar-text-color-dark = theme-config("color.navbarTextDark", "d0d0d0")
$navbar-glass-enable = theme-config-origin("navbar.groundGlass.enable", false)
$navbar-glass-px = theme-config-unit("navbar.groundGlass.px", 0, "px")
$navbar-glass-alpha = theme-config-origin("navbar.groundGlass.alpha", 0)

// banner
$banner-width-height-ratio = theme-config-origin("banner.widthHeightRatio", 0)

// subtitle
$subtitle-color = theme-config("color.subtitle", "#fff")
$subtitle-color-dark = theme-config("color.subtitleDark", "d0d0d0")

// scroll arrow
$scroll-arrow-height-limit = theme-config-origin("scrollDownArrow.bannerHeightLimit", 0)

// board
$board-bg-color = theme-config("color.board", "#fff")
$board-bg-color-dark = theme-config("color.boardDark", "#252d38")

// scrollbar
$scrollbar-color = theme-config("color.scrollbar", "#c4c6c9")
$scrollbar-color-dark = theme-config("color.scrollbarDark", "#687582")
$scrollbar-hover-color = theme-config("color.scrollbarHover", "#a6a6a6")
$scrollbar-hover-color-dark = theme-config("color.scrollbarHoverDark", "#9da8b3")

// code
$highlight-bg-color = highlight-bg-color("light")
$highlight-bg-color-dark = highlight-bg-color("dark")
$inlinecode-bg-color = rgba(175, 184, 193, .2)
$inlinecode-bg-color-dark = rgba(99, 110, 123, .4)

// shadow
$img-shadow = 0 5px 11px 0 rgba(0, 0, 0, .18), 0 4px 15px 0 rgba(0, 0, 0, .15)
